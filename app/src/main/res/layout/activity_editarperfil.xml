<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/texto_Unett"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#23C895"
    android:orientation="vertical"
    tools:context=".displayfeed"
    tools:ignore="ExtraText">


    <!-- AppBar con el logo -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar"
        tools:ignore="MissingConstraints">

        <!-- Toolbar que contiene el logo -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:background="#010201"
            android:minHeight="?attr/actionBarSize"
            app:logoScaleType="centerCrop"
            app:popupTheme="@style/ThemeOverlay.MaterialComponents.Light">

            <!-- Logo de la página -->
            <ImageView
                android:id="@+id/logoImageView"
                android:layout_width="240dp"
                android:layout_height="80dp"
                android:layout_gravity="center"
                android:contentDescription="Logo de la página"
                android:scaleType="centerCrop"
                android:src="@drawable/unettl"
                tools:ignore="HardcodedText" /> <!-- Centra el logo en la barra -->

        </com.google.android.material.appbar.MaterialToolbar>

    </com.google.android.material.appbar.AppBarLayout>


    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="409dp"
        android:layout_height="715dp"
        android:layout_marginTop="75dp"
        app:layout_constraintBottom_toBottomOf="@+id/barra_abajo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/appBar"
        tools:ignore="MissingConstraints,NotSibling,UnknownIdInLayout">


        <androidx.constraintlayout.widget.ConstraintLayout

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="0dp"
            tools:context=".MainActivity">


            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/espacio_perfil"
                android:layout_width="405dp"
                android:layout_height="721dp"
                android:background="#A2E9E0E0"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="1.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.0">


                <TextView
                    android:id="@+id/matriculatxt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Matricula"
                    android:textColor="@color/black"
                    app:layout_constraintBottom_toTopOf="@+id/matriculatext"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/textView3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="Fecha de creacion"
                    android:textColor="@color/black"
                    app:layout_constraintBottom_toTopOf="@+id/fechaCreacion_txt"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.414"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/textView4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Correo"
                    android:textColor="@color/black"
                    app:layout_constraintBottom_toTopOf="@+id/correotext"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.498"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/matriculatext"
                    app:layout_constraintVertical_bias="0.48" />

                <TextView
                    android:id="@+id/correotext"
                    android:layout_width="302dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="92dp"
                    android:editable="true"
                    android:ems="10"
                    android:inputType="text"
                    android:text="Correo:"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="1.0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/matriculatext"
                    tools:ignore="Autofill,Deprecated,HardcodedText,LabelFor,TextViewEdits" />

                <TextView
                    android:id="@+id/fechaCreacion_txt"
                    android:layout_width="302dp"
                    android:layout_height="48dp"
                    android:editable="false"
                    android:ems="10"
                    android:inputType="text"
                    android:text="Fecha de Creación:"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.951"
                    app:layout_constraintStart_toStartOf="parent"
                    tools:ignore="Autofill,Deprecated,HardcodedText,LabelFor,TextViewEdits"
                    tools:layout_editor_absoluteY="509dp" />

                <TextView
                    android:id="@+id/matriculatext"
                    android:layout_width="302dp"
                    android:layout_height="48dp"
                    android:editable="false"
                    android:ems="10"
                    android:inputType="text"
                    android:text="Matrícula:"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.718"
                    app:layout_constraintStart_toStartOf="parent"
                    tools:ignore="Autofill,Deprecated,HardcodedText,LabelFor,TextViewEdits"
                    tools:layout_editor_absoluteY="244dp" />

                <Button
                    android:id="@+id/bt_aplicar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Aplicar
"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/textView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Biografia"
                    android:textColor="@color/black"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.558"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/correotext" />

                <TextView
                    android:id="@+id/textuser"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Username"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.476"
                    app:layout_constraintStart_toStartOf="parent"
                    tools:layout_editor_absoluteY="176dp" />

                <TextView
                    android:id="@+id/contratext"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Contraseña"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.429"
                    app:layout_constraintStart_toStartOf="parent"
                    tools:layout_editor_absoluteY="546dp" />

                <EditText
                    android:id="@+id/textname"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ems="10"
                    android:inputType="text"
                    android:text="Name"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    tools:layout_editor_absoluteY="186dp" />

                <EditText
                    android:id="@+id/biografiatext"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ems="10"
                    android:inputType="text"
                    android:text="Name"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    tools:layout_editor_absoluteY="417dp" />

                <EditText
                    android:id="@+id/passwordtext"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ems="10"
                    android:inputType="textPassword"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    tools:layout_editor_absoluteY="574dp" />

            </androidx.constraintlayout.widget.ConstraintLayout>


        </androidx.constraintlayout.widget.ConstraintLayout>


    </ScrollView>

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/materialToolbar"
        android:layout_width="409dp"
        android:layout_height="95dp"
        android:layout_marginBottom="4dp"
        android:background="#010201"
        android:minHeight="?attr/actionBarSize"
        android:theme="?attr/actionBarTheme"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/scrollView"
        app:layout_constraintVertical_bias="0.0"
        tools:ignore="VisualLintBounds">

        <!-- Primer botón (boton_inicio) -->
        <ImageButton
            android:id="@+id/boton_inicio"
            android:layout_width="90sp"
            android:layout_height="77sp"
            android:backgroundTint="#00FFFFFF"
            android:scaleType="fitCenter"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/home"
            app:tint="@color/white"
            tools:ignore="ContentDescription,SpeakableTextPresentCheck" />


        <!-- Segundo botón (boton_busqueda) -->

        <!-- Tercer botón (boton_agregar) -->
        <ImageButton
            android:id="@+id/boton_agregar"
            android:layout_width="90dp"
            android:layout_height="86dp"
            android:background="#00FFFFFF"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/boton_busqueda"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/plus"
            app:tint="@color/black_opacity"
            tools:ignore="ContentDescription,SpeakableTextPresentCheck" />

        <!-- Cuarto botón (boton_user) -->
        <ImageButton
            android:id="@+id/boton_user"
            android:layout_width="90dp"
            android:layout_height="80dp"
            android:backgroundTint="#020202"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/boton_agregar"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/userr"
            app:tint="#FBF8F8"
            tools:ignore="ContentDescription,SpeakableTextPresentCheck" />

        <!-- Quinto botón (seguidores_button) -->


        <ImageButton
            android:id="@+id/logOutBt"
            android:layout_width="90dp"
            android:layout_height="77dp"
            android:backgroundTint="#020202"
            android:keepScreenOn="true"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/boton_user"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/logout"
            app:tint="#FBF8F8"
            tools:ignore="ContentDescription,SpeakableTextPresentCheck" />

    </com.google.android.material.appbar.MaterialToolbar>


</androidx.constraintlayout.widget.ConstraintLayout>