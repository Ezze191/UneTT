<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:background="#23C895"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".VerOtroPerfil">

    <!-- AppBar con el logo -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar"
        tools:ignore="MissingConstraints">

        <!-- Toolbar que contiene el logo -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:background="#010201"
            android:minHeight="?attr/actionBarSize"
            app:logoScaleType="centerCrop"
            app:popupTheme="@style/ThemeOverlay.MaterialComponents.Light">

            <!-- Logo de la página -->
            <ImageView
                android:id="@+id/logoImageView"
                android:layout_width="240dp"
                android:layout_height="80dp"
                android:layout_gravity="center"
                android:contentDescription="Logo de la página"
                android:scaleType="centerCrop"
                android:src="@drawable/unettl"
                tools:ignore="HardcodedText" /> <!-- Centra el logo en la barra -->

        </com.google.android.material.appbar.MaterialToolbar>

    </com.google.android.material.appbar.AppBarLayout>


    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="409dp"
        android:layout_height="715dp"
        android:layout_marginTop="75dp"
        app:layout_constraintBottom_toBottomOf="@+id/barra_abajo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/appBar"
        tools:ignore="MissingConstraints,NotSibling,UnknownIdInLayout">


        <androidx.constraintlayout.widget.ConstraintLayout

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="0dp"
            tools:context=".MainActivity">


            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/espacio_perfil"
                android:layout_width="405dp"
                android:layout_height="721dp"
                android:background="#A2E9E0E0"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.0">


                <TextView
                    android:id="@+id/correotext"
                    android:layout_width="302dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="92dp"
                    android:editable="true"
                    android:ems="10"
                    android:inputType="text"
                    android:text="Correo:"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.466"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/matriculatext"
                    tools:ignore="Autofill,Deprecated,HardcodedText,LabelFor,TextViewEdits" />

                <TextView
                    android:id="@+id/fechatext"
                    android:layout_width="302dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="92dp"
                    android:editable="false"
                    android:ems="10"
                    android:inputType="text"
                    android:text="Fecha de Creación:"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.466"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/biografiatext"
                    tools:ignore="Autofill,Deprecated,HardcodedText,LabelFor,TextViewEdits" />


                <TextView
                    android:id="@+id/matriculatext"
                    android:layout_width="302dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:editable="false"
                    android:ems="10"
                    android:inputType="text"
                    android:text="Matrícula:"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.472"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/textname"
                    tools:ignore="Autofill,Deprecated,HardcodedText,LabelFor,TextViewEdits" />

                <ImageView
                    android:id="@+id/imagen_publicacion"
                    android:layout_width="407dp"
                    android:layout_height="115dp"
                    android:contentDescription="Descripción de la imagen"
                    android:scaleType="centerCrop"
                    android:src="@drawable/portadaperfil"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.428"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0.0"
                    tools:ignore="HardcodedText" />

                <ImageView
                    android:id="@+id/imagen_perfil"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:background="@drawable/circular_shape"
                    android:src="@drawable/logounett"
                    android:visibility="visible"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/imagen_publicacion"
                    app:layout_constraintVertical_bias="0.137"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/textname"
                    android:layout_width="300dp"
                    android:layout_height="40dp"
                    android:text="USERNAME"
                    android:textAlignment="center"
                    android:textColor="#121111"
                    android:textSize="24sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/imagen_perfil"
                    tools:ignore="HardcodedText,TextSizeCheck" />


                <TextView
                    android:id="@+id/biografiatext"
                    android:layout_width="302dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="104dp"
                    android:ems="10"
                    android:inputType="text"
                    android:text="Biografía:"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.485"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/correotext"
                    tools:ignore="Autofill,HardcodedText,LabelFor,TextViewEdits" />

            </androidx.constraintlayout.widget.ConstraintLayout>


        </androidx.constraintlayout.widget.ConstraintLayout>


    </ScrollView>

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/materialToolbar"
        android:layout_width="414dp"
        android:layout_height="105dp"
        android:layout_marginBottom="4dp"
        android:background="#010201"
        android:minHeight="?attr/actionBarSize"
        android:theme="?attr/actionBarTheme"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/scrollView"
        app:layout_constraintVertical_bias="0.0"
        tools:ignore="VisualLintBounds">

        <!-- Contenedor horizontal para centrar los botones -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="8dp">

            <!-- Primer botón (boton_inicio) -->
            <ImageButton
                android:id="@+id/boton_inicio"
                android:layout_width="90dp"
                android:layout_height="77dp"
                android:backgroundTint="#00FFFFFF"
                android:scaleType="centerCrop"
                app:srcCompat="@drawable/home"
                app:tint="@color/white"
                tools:ignore="ContentDescription,SpeakableTextPresentCheck" />

            <ImageButton
                android:id="@+id/boton_agregar"
                android:layout_width="90dp"
                android:layout_height="77dp"
                android:background="#00FFFFFF"
                android:scaleType="center"
                android:scaleX="1.5"
                android:scaleY="1.5"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/plus"
                app:tint="@color/black_opacity"
                tools:ignore="ContentDescription,SpeakableTextPresentCheck" />

            <!-- Cuarto botón (boton_user) -->
            <ImageButton
                android:id="@+id/boton_user"
                android:layout_width="90dp"
                android:layout_height="80dp"
                android:backgroundTint="#020202"
                android:scaleType="centerInside"
                android:scaleX="1"
                android:scaleY="1"
                app:srcCompat="@drawable/userr"
                app:tint="#FBF8F8"
                tools:ignore="ContentDescription,SpeakableTextPresentCheck" />

            <!-- Quinto botón (logOutBt) -->
            <ImageButton
                android:id="@+id/logOutBt"
                android:layout_width="90dp"
                android:layout_height="77dp"
                android:backgroundTint="#020202"
                android:keepScreenOn="true"
                android:scaleType="centerCrop"
                app:srcCompat="@drawable/logout"
                app:tint="#FBF8F8"
                tools:ignore="ContentDescription,SpeakableTextPresentCheck" />
        </LinearLayout>

    </com.google.android.material.appbar.MaterialToolbar>


</androidx.constraintlayout.widget.ConstraintLayout>