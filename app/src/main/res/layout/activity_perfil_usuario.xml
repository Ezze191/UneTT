<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/texto_Unett"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#23C895"
    tools:context=".displayfeed"
    tools:ignore="ExtraText">


    <!-- AppBar con el logo -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar"
        tools:ignore="MissingConstraints">

        <!-- Toolbar que contiene el logo -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:background="#010201"
            android:minHeight="?attr/actionBarSize"
            app:logoScaleType="centerCrop"
            app:popupTheme="@style/ThemeOverlay.MaterialComponents.Light">

            <!-- Logo de la página -->
            <ImageView
                android:id="@+id/logoImageView"
                android:layout_width="240dp"
                android:layout_height="80dp"
                android:layout_gravity="center"
                android:contentDescription="Logo de la página"
                android:scaleType="centerCrop"
                android:src="@drawable/unettl" /> <!-- Centra el logo en la barra -->

        </com.google.android.material.appbar.MaterialToolbar>

    </com.google.android.material.appbar.AppBarLayout>


    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="405dp"
        android:layout_height="684dp"
        android:layout_marginTop="100dp"
        app:layout_constraintBottom_toBottomOf="@+id/barra_abajo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/appBar"
        tools:ignore="MissingConstraints,NotSibling">



        <androidx.constraintlayout.widget.ConstraintLayout

            android:layout_width="409dp"
            android:layout_height="548dp"
            android:padding="0dp"
            tools:context=".MainActivity">


            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/espacio_perfil"
                android:layout_width="406dp"
                android:layout_height="228dp"
                android:layout_marginTop="136dp"
                android:background="#A2E9E0E0"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="@id/barra_arriba">


                <ImageView
                    android:id="@+id/imagen_publicacion"
                    android:layout_width="400dp"
                    android:layout_height="147dp"
                    android:layout_marginBottom="116dp"
                    android:contentDescription="Descripción de la imagen"
                    android:src="@drawable/fondo_imagen"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.428"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/texto_publicacion"
                    app:layout_constraintVertical_bias="0.0" />

                <ImageView
                    android:id="@+id/imagen_perfil"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:background="@drawable/circular_shape"
                    android:src="@drawable/imagen_perfil"
                    android:visibility="visible"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.498"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/imagen_publicacion"
                    app:layout_constraintVertical_bias="0.497" />

                <TextView
                    android:id="@+id/textView"
                    android:layout_width="300dp"
                    android:layout_height="40dp"
                    android:text="FERNANDO AYALA"
                    android:textAlignment="center"
                    android:textColor="#121111"
                    android:textSize="24sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.495"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/imagen_perfil"
                    app:layout_constraintVertical_bias="0.0" />

                <Button
                    android:id="@+id/btcerrarsession"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cerrar Session"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/textView" />

            </androidx.constraintlayout.widget.ConstraintLayout>


        </androidx.constraintlayout.widget.ConstraintLayout>


    </ScrollView>

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/materialToolbar"
        android:layout_width="0dp"
        android:layout_height="95dp"
        android:layout_marginBottom="4dp"
        android:background="#010201"
        android:minHeight="?attr/actionBarSize"
        android:theme="?attr/actionBarTheme"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Primer botón (boton_inicio) -->
        <ImageButton
            android:id="@+id/boton_inicio"
            android:layout_width="77sp"
            android:layout_height="77sp"
            android:backgroundTint="#00FFFFFF"
            android:scaleType="fitCenter"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/home"
            app:tint="@color/white"
            tools:ignore="ContentDescription,SpeakableTextPresentCheck"/>


        <!-- Segundo botón (boton_busqueda) -->
        <ImageButton
            android:id="@+id/boton_busqueda"
            android:layout_width="77dp"
            android:layout_height="77dp"
            android:backgroundTint="#00FFFFFF"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/boton_inicio"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/search"
            app:tint="@color/white"
            tools:ignore="ContentDescription,SpeakableTextPresentCheck" />

        <!-- Tercer botón (boton_agregar) -->
        <ImageButton
            android:id="@+id/boton_agregar"
            android:layout_width="77dp"
            android:layout_height="80dp"
            android:background="#00FFFFFF"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/boton_busqueda"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/plus"
            app:tint="@color/black_opacity"
            tools:ignore="ContentDescription,SpeakableTextPresentCheck" />

        <!-- Cuarto botón (boton_user) -->
        <ImageButton
            android:id="@+id/boton_user"
            android:layout_width="77dp"
            android:layout_height="80dp"
            android:backgroundTint="#020202"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/boton_agregar"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/userr"
            app:tint="#FBF8F8"
            tools:ignore="ContentDescription,SpeakableTextPresentCheck" />

        <!-- Quinto botón (seguidores_button) -->
        <ImageButton
            android:id="@+id/seguidores_button"
            android:layout_width="76dp"
            android:layout_height="77dp"
            android:backgroundTint="#020202"
            android:keepScreenOn="true"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/boton_user"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/seguidores"
            app:tint="#FBF8F8"
            tools:ignore="ContentDescription,SpeakableTextPresentCheck" />

    </com.google.android.material.appbar.MaterialToolbar>



</androidx.constraintlayout.widget.ConstraintLayout>











